{
  "name": "quizeit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "up": "npm run docker:up && npm run build && npm start",
    "down": "node scripts/docker.mjs --stop",
    "docker:up": "node scripts/docker.mjs",
    "dev": "node --env-file-if-exists=.env --watch scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "judge0:up": "node scripts/docker.mjs judge0",
    "judge0:stop": "node scripts/docker.mjs judge0 --stop",
    "editor:up": "node scripts/docker.mjs editor",
    "editor:stop": "node scripts/docker.mjs editor --stop",
    "mongo:up": "node scripts/docker.mjs mongo",
    "mongo:stop": "node scripts/docker.mjs mongo --stop",
    "mongo:migrate": "node --env-file-if-exists=.env scripts/migrate-mongo.mjs",
    "exam-images:migrate": "node --env-file-if-exists=.env scripts/migrate-exam-images.mjs",
    "account:owner": "node --env-file-if-exists=.env scripts/set-owner.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "express": "5.2.1",
    "jose": "^6.2.17",
    "monaco-editor": "0.57.0",
    "mongodb": "^7.9.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
