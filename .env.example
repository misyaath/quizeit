# NestJS and React
QUIZEIT_PORT=5173
# Optional plugin allowlist path. Blank uses plugins.config.json.
QUIZEIT_PLUGIN_CONFIG=

# MongoDB. Leave the URI empty to use the local Docker service.
# For Atlas, paste the connection string with a URL-encoded password.
MONGODB_URI=
MONGODB_DATABASE=quizeit
QUIZEIT_MONGO_PORT=
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Judge0. Leave the URL empty to use the local Docker service.
JUDGE0_URL=
JUDGE0_PORT=2358
JUDGE0_TOKEN=
JUDGE0_POSTGRES_PASSWORD=
JUDGE0_REDIS_PASSWORD=

# VS Code editor. Startup fills the UID and GID from your Linux user.
EDITOR_PORT=
EDITOR_UID=
EDITOR_GID=
EDITOR_PASSWORD=

# Startup imports legacy values for blank settings and generates missing passwords.
# Default local ports are 27017 for MongoDB and 8180 for the editor.
# Configure ChatGPT and OpenAI Platform credentials in the app's Settings.

# Optional Google sign-in. Use a Google OAuth Web application.
# Add http://127.0.0.1:5173/auth/google/callback to its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Real exam links. Configure an HTTPS origin for remote candidates.
# The reverse proxy must overwrite Host and X-Forwarded-For.
QUIZEIT_PUBLIC_URL=
QUIZEIT_TRUST_PROXY=0
# Optional Resend delivery for invitation emails. Use a verified sender.
QUIZEIT_RESEND_API_KEY=
QUIZEIT_EXAM_FROM=

# Private screenshot and webcam photo storage. Blank uses local-data/exam-images.
QUIZEIT_EXAM_IMAGES_DIR=
